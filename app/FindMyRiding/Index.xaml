<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FindMyRidingApp"
             x:Class="FindMyRidingApp.IndexPage"
    Title="FindMyRiding"
    BackgroundColor="{AppThemeBinding Light=#F7F8FA, Dark=#101418}">
    <ContentPage.Behaviors>
        <local:ThemedStatusBarBehavior x:Name="StatusBarBehavior" />
    </ContentPage.Behaviors>
    <VerticalStackLayout Padding="24" Spacing="20"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"
                           MaximumWidthRequest="440">
        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
            <Label Text="FindMyRiding" Style="{StaticResource PageTitle}" />
            <Label Text="Which riding are you in?" Style="{StaticResource MutedSmall}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Frame Style="{StaticResource RidingCard}" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="FEDERAL RIDING" Style="{StaticResource SectionHeading}"
                               Grid.Column="0" VerticalOptions="Center" />
                        <Label x:Name="FederalIdLabel" Style="{StaticResource SectionId}"
                               Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="FederalLabel" Text="…" Style="{StaticResource ResultValue}" />
                </VerticalStackLayout>
                <BoxView HeightRequest="1"
                          Color="{AppThemeBinding Light=#E4E7EA, Dark=#2A3037}" />
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label x:Name="ProvincialHeading" Text="PROVINCIAL / TERRITORIAL RIDING"
                               Style="{StaticResource SectionHeading}"
                               Grid.Column="0" VerticalOptions="Center" />
                        <Label x:Name="ProvincialIdLabel" Style="{StaticResource SectionId}"
                               Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                    <Label x:Name="ProvincialLabel" Text="…" Style="{StaticResource ResultValue}" />
                </VerticalStackLayout>
                <Label x:Name="LocationLabel" Style="{StaticResource MutedSmall}" />
            </VerticalStackLayout>
        </Frame>

        <Button x:Name="UseGpsButton" Text="Use device location" Clicked="OnUseGpsClicked"
                Style="{StaticResource PrimaryButton}" />

        <VerticalStackLayout Spacing="10">
            <Label Text="Check another location" Style="{StaticResource SectionHeading}" />
            <Frame Style="{StaticResource InputCard}" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                        <Entry x:Name="LatEntry" Grid.Column="0" Placeholder="Latitude"
                               Style="{StaticResource CoordEntry}" />
                        <Entry x:Name="LngEntry" Grid.Column="1" Placeholder="Longitude"
                               Style="{StaticResource CoordEntry}" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
            <Button x:Name="ApplyButton" Text="Use manual location" Clicked="OnApplyClicked"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>

        <Label x:Name="StatusLabel" Text="Checking location…" Style="{StaticResource MutedSmall}"
               HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
</ContentPage>

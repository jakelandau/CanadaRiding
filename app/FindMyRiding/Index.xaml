<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:FindMyRidingApp"
             x:Class="FindMyRidingApp.IndexPage"
             Title="FindMyRiding">
    <ContentPage.Behaviors>
        <local:ThemedStatusBarBehavior x:Name="StatusBarBehavior" />
    </ContentPage.Behaviors>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Text="FindMyRiding" FontAttributes="Bold" FontSize="32" HorizontalOptions="Center"
               Grid.Row="0" Padding="24,48,24,0" />
        <VerticalStackLayout Grid.Row="1" Padding="24" Spacing="12" VerticalOptions="Center">
            <Label x:Name="FederalLabel" FontAttributes="Bold" FontSize="18" />
            <Label x:Name="ProvincialLabel" FontAttributes="Bold" FontSize="18" />
            <Label x:Name="LocationLabel" />
            <Label Text="Check another location" />
            <HorizontalStackLayout Spacing="8">
                <Entry x:Name="LatEntry" Placeholder="Latitude" WidthRequest="110" />
                <Entry x:Name="LngEntry" Placeholder="Longitude" WidthRequest="110" />
                <Button x:Name="ApplyButton" Text="Go" Clicked="OnApplyClicked" />
            </HorizontalStackLayout>
            <Button x:Name="UseGpsButton" Text="Use device location" Clicked="OnUseGpsClicked" />
            <Label x:Name="StatusLabel" Text="Checking location…" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>

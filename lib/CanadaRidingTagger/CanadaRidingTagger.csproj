<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- MinVer: version is derived from git tags, not hand-edited. Cut `v<major.minor.patch>`
         on main (see CHANGELOG.md); untagged dev builds become a pre-release of the next patch.
         MinVerMinimumMajorMinor is the pre-first-tag baseline so dev builds are 0.2.0-alpha, not 0.0.0. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.2</MinVerMinimumMajorMinor>
    <Description>Identifies the Canadian federal riding and province/territory electoral district containing a WGS84 latitude/longitude, from bundled electoral-boundary shapefiles.</Description>
    <Authors>Jake Landau</Authors>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="tools/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CanadaRidingTagger.Tests" />
    <InternalsVisibleTo Include="Preproject" />
    <InternalsVisibleTo Include="ProfileBench" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="NetTopologySuite.IO.GeoJSON" Version="4.0.0" />
    <PackageReference Include="NetTopologySuite.IO.ShapeFile" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\data\FsaCentroids.csv" LogicalName="CanadaRidingTagger.FsaCentroids.csv" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="..\..\data\Shapefiles\Federal\**\*" Pack="true" PackageCopyToOutput="true" PackagePath="contentFiles\any\any\Shapefiles\Federal" />
    <Content Include="..\..\data\Shapefiles\Provincial\**\*" Pack="true" PackageCopyToOutput="true" PackagePath="contentFiles\any\any\Shapefiles\Provincial" />
    <Content Include="..\..\data\Shapefiles\Territorial\**\*" Pack="true" PackageCopyToOutput="true" PackagePath="contentFiles\any\any\Shapefiles\Territorial" />
  </ItemGroup>

</Project>
